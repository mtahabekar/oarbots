<?xml version="1.0" encoding="UTF-8" ?>
<!-- CycloneDDS profile for a host wired to the cell's Ethernet switch. Copy to each host, set the
     interface name to that host's wired interface (see `ip -br link`), and export
     CYCLONEDDS_URI=file:///abs/path/cyclonedds_wired.xml with RMW_IMPLEMENTATION=rmw_cyclonedds_cpp.
     The repository's config/profile.xml is the wireless profile and names wlp2s0. -->
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain Id="any">
        <General>
            <Interfaces>
                <NetworkInterface autodetermine="false" name="REPLACE_WITH_WIRED_INTERFACE" />
            </Interfaces>
            <AllowMulticast>spdp</AllowMulticast>
            <MaxMessageSize>65500B</MaxMessageSize>
        </General>
        <Discovery>
            <EnableTopicDiscoveryEndpoints>false</EnableTopicDiscoveryEndpoints>
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>50</MaxAutoParticipantIndex>
        </Discovery>
        <Internal>
            <Watermarks>
                <WhcHigh>500kB</WhcHigh>
            </Watermarks>
        </Internal>
    </Domain>
</CycloneDDS>
