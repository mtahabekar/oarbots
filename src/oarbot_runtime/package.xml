<?xml version="1.0"?>
<package format="3">
  <name>oarbot_runtime</name><version>0.1.0</version>
  <description>Command watchdogs and timestamped human measurements for OARBots.</description>
  <maintainer email="oconna4@rpi.edu">OARBot maintainers</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend><exec_depend>kinova_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend><exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend><exec_depend>tf2_geometry_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
