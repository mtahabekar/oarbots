Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Floor grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Plane: XY
      Plane Cell Count: 8
      Cell Size: 0.25
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/RobotModel
      Name: oarbot_blue
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /oarbot_blue/robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/RobotModel
      Name: oarbot_silver
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /oarbot_silver/robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Estimated sheet (sensors only)
      Enabled: true
      Topic:
        Value: /fabric/demo_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        estimate: true
    - Class: rviz_default_plugins/Camera
      Name: Overhead camera + estimate
      Enabled: true
      Topic:
        Value: /nuc/rgb/image_raw
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Image Rendering: background and overlay
      Overlay Alpha: 0.6
      Zoom Factor: 1
      Visibility:
        Floor grid: false
        oarbot_blue: false
        oarbot_silver: false
        Estimated sheet (sensors only): true
        Blue wrist camera + estimate: false
        Value: true
    - Class: rviz_default_plugins/Camera
      Name: Blue wrist camera + estimate
      Enabled: true
      Topic:
        Value: /oarbot_blue/azure_kinect/rgb/image_raw
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Image Rendering: background and overlay
      Overlay Alpha: 0.6
      Zoom Factor: 1
      Visibility:
        Floor grid: false
        oarbot_blue: false
        oarbot_silver: false
        Estimated sheet (sensors only): true
        Overhead camera + estimate: false
        Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 42; 46
    Fixed Frame: world
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 3.2
      Focal Point:
        X: 0
        Y: -0.2
        Z: 0.7
      Pitch: 0.55
      Yaw: 1.2
      Near Clip Distance: 0.01
Window Geometry:
  Width: 1700
  Height: 1000
  Displays:
    collapsed: false
  Views:
    collapsed: true
