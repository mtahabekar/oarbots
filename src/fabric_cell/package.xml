<?xml version="1.0"?>
<package format="3">
  <name>fabric_cell</name><version>0.1.0</version>
  <description>Deployment of the fabric estimator, twin and CBF on the real OARBot cell: launch files and configuration templates</description>
  <maintainer email="oconna4@rpi.edu">OARBot maintainers</maintainer><license>Apache-2.0</license>
  <exec_depend>fabric_perception</exec_depend><exec_depend>human_hand_tracking</exec_depend>
  <exec_depend>fabric_state_estimator</exec_depend><exec_depend>fabric_twin</exec_depend>
  <exec_depend>fabric_sim_cell</exec_depend>
  <!-- robot_host.launch.py also needs oarbot_runtime (and kinova_msgs), which exist only on the helpers. -->
  <exec_depend>launch_ros</exec_depend><exec_depend>rviz2</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
