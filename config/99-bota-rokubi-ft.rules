# Inspect udevadm info for the device SERIAL before enabling a matching rule.
# A vendor-only FTDI rule can alias unrelated serial devices. Use a per-sensor serial.
# SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{serial}=="REPLACE_WITH_ROKUBI_SERIAL", SYMLINK+="sensor_bota_rokubi_ft_0", GROUP="dialout", MODE="0660"
