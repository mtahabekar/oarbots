[Unit]
Description=Continuous Deployment script for NUC
Wants=network-online.target
Requires=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=nuc
ExecStart=/usr/local/bin/nuc_cd.sh
WorkingDirectory=/home/nuc/ros2_ws

KillMode=control-group
TimeoutStopSec=10
SendSIGKILL=yes

# Maintenance only: invoke explicitly, never enable automatic code updates at boot.
