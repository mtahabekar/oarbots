[Unit]
Description=Continuous Deployment script for OARBot silver laptop
Wants=network-online.target
Requires=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=oarbot_silver
ExecStart=/usr/local/bin/oarbot_silver_helper_laptop_cd.sh
WorkingDirectory=/home/oarbot_silver/ros2_ws

KillMode=control-group
TimeoutStopSec=10
SendSIGKILL=yes

# Maintenance only: invoke explicitly, never enable automatic code updates at boot.
