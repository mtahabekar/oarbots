# Default launch arguments for OARBot Silver's fabric session. Command-line arguments override these.
# The Rokubi has no /dev/sensor_bota_rokubi_ft_0 alias on this laptop (checked 2026-11-16).
ft_serial_port:=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AK7GN0G1-if00-port0
# Body tracking is not used by the fabric cell and costs GPU time.
body_tracking:=false
# Blue's Rokubi is plugged into this laptop too (lab log 2026-11-18: on Blue's laptop it makes Blue's
# arm jitter). fabric_session.sh starts its node as fabric-ft-blue; this line is not a launch argument.
hosted_ft:=blue
# Silver's fingers stay closed on its sheet corner (user, 2026-11-18): the guard sends 100 % closure with
# every command while the deadman is held. The driver opens them once when the session starts; put the
# corner in then; the first deadman hold with Fabric Follow (CBF) on for Silver closes them (not a hold for
# Blue alone: the deadman is shared). Blue's gripper is not controllable: no setting.
hold_fingers:=100
