# Default launch arguments for OARBot Blue's fabric session. Command-line arguments override these.
# 2026-11-17: wrist camera and Rokubi reconnected (the Rokubi has no /dev/sensor_bota_rokubi_ft_0
# alias on this laptop). The gripper is not connected electrically, and the arm's controller does not
# detect its actuators after firmware work (lab log 2026-11-17), so the arm driver fails at start.
ft_serial_port:=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_AK6VFMAU-if00-port0
# Body tracking is not used by the fabric cell and costs GPU time.
body_tracking:=false
