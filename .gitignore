# Ignore default directories created by colcon
build/
install/
log/

# Ignore Visual Studio Code local configuration
.vscode/

# Ignore JetBrains local configuration
.idea/

# Ignore Python virtual environment
.venv/
# Python build and test artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Raw Isaac run recordings (hundreds of MB, over GitHub's 100 MB file limit).
# Full copies live on the external drive:
#   /media/taha/ExtermeLinux/oarbot_simulation/logs/material_runs/
experiments/material_*/estimate.npz
experiments/material_*/truth.npz
experiments/material_*/twin.npz

# Raw hardware estimator and twin recordings. Keep summaries and compressed logs.
experiments/hardware/sessions/*_fabric_run/**/estimate.npz
experiments/hardware/sessions/*_fabric_run/**/twin.npz
experiments/hardware/sessions/*_fabric_run/**/twin.cbf.jsonl
experiments/hardware/sessions/*_fabric_run/**/twin.depth.npz
experiments/hardware/sessions/*_fabric_run/**/*.tmp.npz

# Per-run camera perception logs (3-9 MB each, three per run): kept with the run's other large files in
# /home/taha/fabric_hw_data/<day>_fabric_run_<run>/cameras/ (fabric_run.sh save writes them there).
experiments/hardware/sessions/**/cameras/*_perception_logs.tar.gz
# Run bags (mcap) and other raw recordings: fabric_run.sh save moves them to /home/taha/fabric_hw_data.
experiments/**/bag/
experiments/**/*.mcap
experiments/**/*.db3
experiments/hardware/sessions/**/twin.npz
experiments/hardware/sessions/**/estimate.npz
experiments/hardware/sessions/**/twin.depth.npz
# Simulation recordings (Isaac cell, headless twin, warm-up design and calibration sweeps): raw arrays and videos.
experiments/sim_eval/**/*.npz
experiments/**/*.mp4
experiments/**/*.usd
